{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "checkpoint.schema.json",
  "type": "object",
  "required": [
    "opencheckpoint",
    "id",
    "created_at",
    "source",
    "task"
  ],
  "properties": {
    "opencheckpoint": {
      "description": "Specification version this document conforms to, as MAJOR.MINOR.",
      "const": "0.1"
    },
    "id": {
      "description": "Globally unique identifier of this checkpoint. SHOULD be a urn:uuid URN.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "parent": {
      "$ref": "#/$defs/parent"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "task": {
      "$ref": "#/$defs/task"
    },
    "progress": {
      "$ref": "#/$defs/progress"
    },
    "statements": {
      "$ref": "#/$defs/statements"
    },
    "resources": {
      "$ref": "#/$defs/resources"
    },
    "application_context": {
      "$ref": "#/$defs/application_context"
    },
    "operations": {
      "$ref": "#/$defs/operations"
    },
    "continuation": {
      "$ref": "#/$defs/continuation"
    },
    "derivation": {
      "$ref": "#/$defs/derivation"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": {
      "$ref": "https://json-schema.org/draft/2020-12/schema#",
      "description": "RFC 3339 `date-time` with an explicit offset (`Z` or `±hh:mm`).",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})|\"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})\")$"
    },
    "localId": {
      "$ref": "#/$defs/id",
      "description": "Identifier of an object within this document. Unique across all objects in the document."
    },
    "localRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/localId"
      },
      "uniqueItems": true,
      "description": "References to objects in this document by local identifier."
    },
    "text": {
      "type": "string"
    },
    "digest": {
      "$ref": "#/$defs/id",
      "description": "Hash algorithm name from the IANA Named Information registry, e.g. sha-256. A conforming validator MUST NOT reject a document solely because a value fails a `format`."
    },
    "parent": {
      "$ref": "#",
      "description": "The checkpoint this one was derived from, with an optional digest of its bytes.",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "softwareRef": {
      "$ref": "#/$defs/softwareRef",
      "description": "The producer, agent, model or session references that record the provenance of this checkpoint."
    },
    "sessionRef": {
      "$ref": "#/$defs/sessionRef",
      "description": "A pointer into session records kept by other protocols: an A2A contextId or task id, an ACP session id, a Session Protocol session and event id, Open Responses response id. The checkpoint consumer can read the original history if it can."
    },
    "source": {
      "$ref": "#",
      "description": "Producer, agent, model, and session references. Informational (§6.1).",
      "properties": {
        "producer": {
          "$ref": "#/$defs/softwareRef"
        },
        "agent": {
          "$ref": "#/$defs/softwareRef"
        },
        "model": {
          "$type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "provider": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "session_refs": {
          "$ref": "#/$defs/sessionRef"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "task": {
      "$ref": "#",
      "description": "Objective, desired outcome, status, success criteria and scope (§6.2). The consumer can check the task's objective and success criteria when evaluating the checkpoint.",
      "properties": {
        "objective": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "const": "active"
        }
      },
      "additionalProperties": false
    },
    "criterion": {
      "$ref": "#",
      "description": "Criterion (a `met`, `unmet` or `unknown` value with optional evidence) of a success criteria that has to be met.",
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "state": {
          "const": "unmet"
        }
      },
      "additionalProperties": false
    },
    "progress": {
      "$ref": "#",
      "description": "Completed steps, current focus and next steps (§6.3). The consumer can check the progress when evaluating the checkpoint.",
      "properties": {
        "completed": {
          "$ref": "#/$defs/completedStep"
        },
        "focus": {
          "$ref": "#/$defs/nextStep"
        },
        "next": {
          "$ref": "#/$defs/nextStep"
        }
      },
      "additionalProperties": false
    },
    "completedStep": {
      "$ref": "#",
      "description": "Work already done, oldest first.",
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "description": {
          "$ref": "#/$defs/text"
        }
      },
      "additionalProperties": false
    },
    "nextStep": {
      "$ref": "#",
      "description": "Recommended next steps, in suggested order.",
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "blocked_by": {
          "$ref": "#/$defs/localRefs"
        },
        "requires": {
          "$ref": "#/$defs/localRefs"
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "$ref": "#",
      "description": "Whether and how the source checked a statement.",
      "properties": {
        "state": {
          "enum": [
            "verified",
            "unverified",
            "disputed",
            "stale"
          ]
        },
        "checked_at": {
          "$ref": "#/$defs/timestamp"
        },
        "revalidate": {
          "const": ""
        }
      },
      "additionalProperties": false
    },
    "statement": {
      "$ref": "#",
      "description": "A statement with provenance, kind and origin (§6.5). The consumer can check the source of the content for a text field when evaluating the checkpoint.",
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "kind": {
          "description": "instruction: A directive from the user or the operating system. constraint: A boundary that work must respect. decision: A choice already made. observation: Something found to be true. hypothesis: Something believed but not established. question: Something unresolved. external: Content quoted from a third party, which carries no instruction authority.",
          "enum": [
            "instruction",
            "constraint",
            "decision",
            "observation",
            "hypothesis",
            "question",
            "external"
          ]
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "origin": {
          "description": "Where a statement came from. As reported by the source system; a consumer treats it as a claim, not proof.",
          "properties": {
            "type": {
              "const": "agent"
            }
          },
          "additionalProperties": false
        },
        "status": {
          "const": "active"
        },
        "superseded_by": {
          "$ref": "#/$defs/localId"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "instruction"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "origin": {
                "description": "Where a statement came from. As reported by the source system; a consumer treats it as a claim, not proof.",
                "properties": {
                  "type": {
                    "const": "user"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hypothesis"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "resolved"
              },
              "resolution": {
                "$ref": "#/$defs/text"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "external"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "origin": {
                "description": "Where a statement came from. As reported by the source system; a consumer treats it as a claim, not proof.",
                "properties": {
                  "type": {
                    "const": "external"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "decision"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "rationale": {
                "$ref": "#/$defs/text"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "question"
              },
              "resolution": {
                "$ref": "#/$defs/text"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "kind": {
                      "const": "decision"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                {
                  "properties": {
                    "kind": {
                      "const": "hypothesis"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              ]
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "status": {
                      "enum": [
                        "superseded",
                        "resolved"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "origin": {
      "$ref": "#",
      "description": "Where a statement came from. As reported by the source system; a consumer treats it as a claim, not proof.",
      "properties": {
        "type": {
          "enum": [
            "user",
            "system",
            "agent",
            "tool",
            "application",
            "external"
          ]
        },
        "name": {
          "$ref": "#/$defs/text"
        }
      },
      "additionalProperties": false
    },
    "resource": {
      "$ref": "#",
      "description": "A reference to a file, record, document or other object that the task involves. The consumer can resolve references to objects and check revisions (when available) when evaluating the checkpoint.",
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "kind": {
          "description": "file: A file in a repository. repository: A source control system or other versioned object store. document: A data format, such as PDF, DOCX, JSON, YAML. record: An ERP or similar business system's record of something. web: A web page. artifact: The result of some tooling. message: Email, chat. other: Custom resource type. The kind can be extended (e.g., by adding additional text to `kind`).",
          "enum": [
            "file",
            "repository",
            "document",
            "record",
            "web",
            "artifact",
            "tool_output",
            "dataset",
            "message",
            "other"
          ]
        },
        "uri": {
          "$ref": "#/$defs/id"
        },
        "locator": {
          "$ref": "#/$defs/locator",
          "description": "Identifies an object that has no URI: a kind and key within a named system. The consumer can use the system, type and key to resolve references (for example, invoices in an ERP) when evaluating the checkpoint.",
          "properties": {
            "system": {
              "$ref": "#/$defs/text"
            },
            "type": {
              "description": "The kind of resource.",
              "type": "string"
            },
            "key": {
              "description": "A unique identifier for this object within its system. The consumer can use the key to resolve references (for example, an invoice in an ERP) when evaluating the checkpoint.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "media_type": {
          "description": "The type of media, if known.",
          "pattern": "^([A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(\\s*;.*)?|\"[A-Za-z0-9!#$&^_.+-]+(/[A-Za-z0-9!#$&^_.+-]+)?)$"
        },
        "revision": {
          "$ref": "#/$defs/text"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "availability": {
          "description": "Whether the source could access the resource when it last tried. `available`: Resource was accessible, but may be restricted or unavailable due to network issues. `restricted`: Resource is not available and cannot be accessed by any means. `unavailable`: Resource is not present in the system's view (for example, a file does not exist). The source should NOT attempt to access it.",
          "enum": [
            "available",
            "restricted",
            "unavailable",
            "unknown"
          ]
        },
        "sensitivity": {
          "description": "The level of sensitivity. `public`: Content is public. `internal`: Content is internal and available only in the domain or organization that produced it. `confidential`: Content should not be seen by users (e.g., a credit card number). `restricted`: For example, sensitive data within an otherwise non-sensitive context.",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "resolver": {
          "$ref": "#/$defs/resolver",
          "description": "Hint for how to retrieve the resource. Never contains credentials.",
          "properties": {
            "protocol": {
              "type": "string",
              "minLength": 1
            },
            "hint": {
              "$ref": "#/$defs/resolver_hints_protocol"
            }
          },
          "additionalProperties": false
        },
        "excerpt": {
          "$ref": "#/$defs/text",
          "description": "A short inline excerpt. Large content is referenced, not embedded.",
          "maxLength": 4096
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "file"
              }
            },
            "required": [
              "uri"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "locator": {}
                  },
                  "required": [
                    "locator"
                  ]
                },
                {
                  "properties": {
                    "uri": {}
                  },
                  "required": [
                    "uri"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "web"
              }
            },
            "required": [
              "title"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "locator": {}
                  },
                  "required": [
                    "locator"
                  ]
                },
                {
                  "properties": {
                    "uri": {}
                  },
                  "required": [
                    "uri"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "dataset"
              }
            },
            "required": [
              "title"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "locator": {}
                  },
                  "required": [
                    "locator"
                  ]
                },
                {
                  "properties": {
                    "uri": {}
                  },
                  "required": [
                    "uri"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "application_context": {
      "$ref": "#",
      "description": "Application state relevant to the task that did not necessarily originate in conversation. The consumer can retrieve resources by their keys (for example invoices, payments) and use application-defined selection filters and drafts when evaluating the checkpoint.",
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "application": {
          "$ref": "#/$defs/softwareRef"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "application"
            ],
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "selections": {}
                  },
                  "required": [
                    "selections"
                  ]
                },
                {
                  "properties": {
                    "drafts": {}
                  },
                  "required": [
                    "drafts"
                  ]
                }
              ]
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "selections": {}
                  },
                  "required": [
                    "selections"
                  ]
                },
                {
                  "properties": {
                    "drafts": {}
                  },
                  "required": [
                    "drafts"
                  ]
                }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "operation": {
      "$ref": "#",
      "description": "Approvals, requested input, external actions and waits that are not finished (§6.6). The consumer can check the source of the content for a text field when evaluating the checkpoint.",
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "kind": {
          "const": "action"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "const": "uncertain"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "approval"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "kind": {
                    "const": "input"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "properties": {
                  "kind": {
                    "const": "wait"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "status": {
                      "const": "uncertain"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "requirement": {
      "$ref": "#",
      "description": "Requirements (§6.8) of the continuation to be considered before resuming.",
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "kind": {
          "description": "tool: A callable tool. capability: A general ability, e.g. code execution. access: Access to a resource which the destination must already hold. extension: A checkpoint extension the consumer must understand in order to interpret the document fully.",
          "enum": [
            "tool",
            "capability",
            "access",
            "extension"
          ]
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "necessity": {
          "description": "required: Continuation must not proceed without it. recommended: Continuation can proceed degraded. optional: Convenience.",
          "enum": [
            "required",
            "recommended",
            "optional"
          ]
        },
        "fallback": {
          "$ref": "#/$defs/text"
        }
      },
      "additionalProperties": false
    },
    "stop_condition": {
      "$ref": "#",
      "description": "A stop condition (§6.8).",
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "description": {
          "$ref": "#/$defs/text"
        }
      },
      "additionalProperties": false
    },
    "recovery_action": {
      "$ref": "#",
      "description": "A recovery action (§6.8).",
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "description": {
          "$ref": "#/$defs/text"
        }
      },
      "additionalProperties": false
    },
    "derivation_input": {
      "$ref": "#/$defs/derivation_input"
    },
    "derivation_omission": {
      "$ref": "#/$defs/derivation_omission"
    },
    "derivation_transformation": {
      "$ref": "#/$defs/derivation_transformation"
    },
    "resolver_hints_protocol": {
      "$ref": "#/$defs/id"
    },
    "resolver_hints_uri": {
      "$type": "string",
      "format": "uri",
      "description": "A hint for how to resolve the URI, but does not contain the URI. `type` must be a scheme (e.g., http)."
    },
    "session_ref": {
      "$ref": "#/$defs/session_ref",
      "description": "A pointer into session records kept by other protocols: an A2A contextId or task id, an ACP session id, a Session Protocol session and event id, Open Responses response id. The checkpoint consumer can read the original history if it can."
    },
    "resolver_hints_uri_scheme": {
      "$ref": "#/$defs/id"
    }
  }
}
