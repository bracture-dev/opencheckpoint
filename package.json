{
  "name": "opencheckpoint-repo",
  "private": true,
  "description": "Specification, schema, fixtures, and conformance harness for OpenCheckpoint.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "test": "node tools/conformance.mjs",
    "check": "node tools/conformance.mjs && prettier --check .",
    "format": "prettier --write .",
    "docs:dev": "npm run dev --workspace docs",
    "docs:build": "npm run build --workspace docs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prettier": "3.9.9"
  }
}
